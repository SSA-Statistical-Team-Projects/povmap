\description{
The function \code{xgb} employs extreme gradient boosting to estimate domain-level averages, particularly
for small area estimation (SAE) applications. The model is specified
at the sub-area level (any geopgraphic level more disaggregated than the target areas),
as implemented by \cite{Merfeld, Dang, and Newhouse (2025)} To estimate the mean squared
error (MSE), a nonparametric residual bootstrap approach is utilized, as described
in \cite{Krennmair and Schmid (2022)} and \cite{Merfeld, Dang, and Newhouse (2025)}.
}
\section{Out-of-fold residual pools, usage}{

\preformatted{
tune <- xgb_tune(fixed, smp_data, smp_weights = "wt", domains = "dom",
                 transformation = "arcsin", search = "random", n_iter = 150,
                 seed = 1, overfit_ratio = TRUE, keep_oof = TRUE)
cfg  <- xgb_top_configs(tune, rule = "least_overfit", ratio_pool = "domain")
est  <- xgb(fixed, smp_data, "wt", pop_data, "npop", domains = "dom",
            sub_domains = "sub", transformation = "arcsin",
            configs = cfg,
            area_pool = "out_of_fold", pool_tune = tune,      # no new fits
            sub_pool = "out_of_fold",                          # fits on sub-area folds
            area_deflate = TRUE, sub_deflate = TRUE,
            area_sampling_var = c("01" = 4e-4, "02" = 9e-4),   # named by domain, response-scale variance
            sub_sampling_var = "vy")                           # smp_data column, response-scale variance
est$pools$configs[[1]]$area_deflation$factor
}
}

\examples{
\donttest{
# Loading data - population and sample data
data("eusilcA_pop")
data("eusilcA_smp")

# Create subdomains: Equal to individuals in each area
eusilcA_smp$subDomain <- ave(seq_along(eusilcA_smp$district),
                             eusilcA_smp$district,
                             FUN = seq_along)
eusilcA_pop$subDomain <- ave(seq_along(eusilcA_pop$district),
                             eusilcA_pop$district,
                             FUN = seq_along)
# Sample and population weights (equal weights here)
eusilcA_pop$pop_weight <- 1
eusilcA_smp$smp_weight <- 1

# Estimate extreme gradient boosting model
xgb_model <- xgb(fixed = eqIncome ~ eqsize + cash + self_empl +
                 unempl_ben + age_ben + surv_ben + sick_ben+
                 dis_ben +rent + fam_allow + house_allow +
                 cap_inv + tax_adj + subDomain,
                 smp_data = eusilcA_smp,
                 pop_data = eusilcA_pop,
                 smp_weights = "smp_weight",
                 pop_weights = "pop_weight",
                 domains = "district",
                 sub_domains = "subDomain",
                 area_pool = "in_sample") # the example sample rows do not map one to one onto census cells

# Extract Mean, MSE and CV
estimators(object = xgb_model, indicator = "Mean",
           MSE = TRUE, CV =TRUE)

# Plot the results on a map
load_shapeaustria()
map_plot(object = xgb_model, MSE = FALSE, CV = TRUE,
         map_obj = shape_austria_dis, indicator = c("Mean"),
         map_dom_id = "PB")
}
}
